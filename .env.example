# Copy to .env and fill in real values. Never commit .env.

# ---------- Backend ----------
PORT=5000

# MongoDB Atlas connection string. End the path with a database name:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/choplist_dev?retryWrites=true&w=majority
# Without /choplist_dev MongoDB silently uses a database called "test".
# Use a *_dev database locally; the real one is set on Render.
MONGO_URI=

# Tests only. A throwaway MongoDB whose database name ends in _test; the tests
# DELETE it. Never an Atlas cluster with real data. Locally:
#   docker run -d --name choplist-mongo-test -p 27018:27017 mongo:7
MONGO_URI_TEST=mongodb://127.0.0.1:27018/choplist_test

# Clerk dashboard > your app > API keys.
CLERK_SECRET_KEY=            # starts with sk_
CLERK_PUBLISHABLE_KEY=       # starts with pk_ (same value as VITE_CLERK_PUBLISHABLE_KEY)

# How many proxies sit in front of the API; the rate limits use it to find the real
# customer address. Locally there are none: leave it unset (1) or use 0.
# On Render it must be 3 (checked on the live service; see backend/README.md).
# Too low: customers share one counter. Too high: a client can fake its address.
TRUST_PROXY_HOPS=1

# Browser origins allowed to call the API, comma separated, no trailing slash,
# lowercase, scheme included. Each spelling is its own origin: the apex
# (https://choplistafrica.com) and www are two entries. This same list is also the
# set of sites Clerk sign-in tokens are accepted from, so a missing origin means
# CORS errors AND 401s on sign-in.
# Locally: http://localhost:5173
# On Render during the domain move (new site next to the old one):
#   ALLOWED_ORIGINS=https://choplistafrica.com,https://www.choplistafrica.com,https://choplist.onrender.com
# Drop the onrender.com entry only after the old site is retired. Needs a redeploy.
ALLOWED_ORIGINS=http://localhost:5173

# Clerk user ids allowed to use the admin console (/api/admin), comma separated.
# Find an id in the Clerk dashboard > Users > the user. Empty = nobody is an admin.
# Admins are not sellers. Changing this needs a restart/redeploy.
ADMIN_CLERK_USER_IDS=

# ---------- Pricing and Paystack payments ----------
# ChopList does not hold customer money. Paystack splits each payment and settles the
# seller directly (a Paystack "subaccount"); ChopList's cut is taken at source. There is
# no wallet and no payout code. Manual bank transfer keeps working beside it.
#
# A seller's first FREE_ORDERS paid orders carry no ChopList fee; from the next one the
# fee is PLATFORM_FEE_BPS basis points of the order (100 bps = 1%, so 300 = 3%).
# Changing these affects NEW payments only: each order keeps the fee it was quoted.
FREE_ORDERS=50
PLATFORM_FEE_BPS=300
# Paystack's own charge (about 1.5% + 100 naira, capped, flat fee waived on small
# payments) is NOT set here: it is Paystack's price, kept as constants in
# backend/src/config.ts. Re-check them against https://paystack.com/pricing before
# going live and whenever Paystack changes its pricing.
#
# Paystack dashboard > Settings > API Keys. Use the TEST secret key (sk_test_...) until the
# business is verified; the live key comes later. Never commit it. Leave blank to keep
# payments off (the API then runs on bank transfer only).
PAYSTACK_SECRET_KEY=
# The page on the frontend Paystack sends the customer back to after paying.
PAYSTACK_CALLBACK_URL=

# Not used yet (photo upload and push notifications).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- Frontend ----------
# Vite reads frontend/.env, NOT this file. Copy these two lines into frontend/.env.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CLERK_PUBLISHABLE_KEY=
